# -*- coding: utf-8 -*-
import arcpy
import re
import uuid
from difflib import SequenceMatcher
import tkinter as tk

# ---------------------------------
# تنظيف النص (إزالة الترقيم والمسافات)
# ---------------------------------
def normalize_text(text):
    if text is None:
        return ""
    return re.sub(r"[\/\-\_\. ]", "", str(text)).strip()

# ---------------------------------
# حساب نسبة التشابه
# ---------------------------------
def similarity(a, b):
    return SequenceMatcher(None, a, b).ratio()

# ---------------------------------
# تحويل اسم الأمانة إلى AMANA_ID
# ---------------------------------
def get_amana_id(amana_name):
    amana_dict = {
        "الرياض": "00101",
        "الطائف": "00201",
        "مكة المكرمة": "00202",
        "جدة": "00203",
        "المدينة المنورة": "00301",
        "القصيم": "00401",
        "الأحساء": "00501",
        "حفر الباطن": "00502",
        "الشرقية": "00503",
        "عسير": "00601",
        "تبوك": "00701",
        "حائل": "00801",
        "الحدود الشمالية": "00901",
        "أجازان": "01001",
        "نجران": "01101",
        "الباحة": "01201",
        "الجوف": "01301"
    }
    return amana_dict.get(amana_name)

# ---------------------------------
# محاولة إضافة Attribute Index (لا توقف الأداة عند الفشل)
# ---------------------------------
def ensure_index(layer_or_fc, field_name):
    try:
        desc = arcpy.Describe(layer_or_fc)
        fc_path = getattr(desc, "catalogPath", layer_or_fc)

        if str(fc_path).lower().startswith("http"):
            return

        fields = [f.name for f in arcpy.ListFields(fc_path)]
        if field_name not in fields:
            return

        for idx in (arcpy.ListIndexes(fc_path) or []):
            if field_name in getattr(idx, "fields", []):
                return

        safe_field = re.sub(r"[^A-Za-z0-9_]", "", field_name).upper()
        suffix = uuid.uuid4().hex[:4].upper()
        idx_name = f"IX_{safe_field[:8]}_{suffix}"

        arcpy.management.AddIndex(fc_path, field_name, idx_name)
    except Exception:
        pass

# ---------------------------------
# نافذة Tkinter بسيطة
# ---------------------------------
def show_simple_window(selected_count):
    root = tk.Tk()
    root.title("نتائج الأداة")
    root.geometry("420x180")
    root.resizable(False, False)

    tk.Label(root, text="نتائج البحث", font=("Segoe UI", 14, "bold")).pack(pady=(14, 8))
    tk.Label(root, text=f"عدد القطع: {selected_count}", font=("Segoe UI", 12)).pack(pady=6)
    tk.Label(root, text="(افتح جدول الطبقة للتفاصيل)", font=("Segoe UI", 11)).pack(pady=6)
    tk.Button(root, text="إغلاق", width=12, command=root.destroy).pack(pady=(14, 8))

    root.mainloop()

# ---------------------------------
# جلب Layer من الخريطة بالـ aliasname (Describe.aliasname)
# ---------------------------------
def get_layer_by_aliasname(map_obj, target_aliasname):
    target = (target_aliasname or "").strip().lower()

    for lyr in map_obj.listLayers():
        if lyr.isGroupLayer:
            for sub in lyr.listLayers():
                try:
                    if (arcpy.Describe(sub).aliasname or "").strip().lower() == target:
                        return sub
                except:
                    continue
        else:
            try:
                if (arcpy.Describe(lyr).aliasname or "").strip().lower() == target:
                    return lyr
            except:
                continue

    return None

# ---------------------------------
# حساب Extent للتحديد الحالي في Layer
# ---------------------------------
def get_selection_extent(layer_for_extent):
    xmin = ymin = float("inf")
    xmax = ymax = float("-inf")
    got_any = False

    with arcpy.da.SearchCursor(layer_for_extent, ["SHAPE@"]) as sc:
        for (geom,) in sc:
            if geom is None:
                continue
            ext = geom.extent
            xmin = min(xmin, ext.XMin)
            ymin = min(ymin, ext.YMin)
            xmax = max(xmax, ext.XMax)
            ymax = max(ymax, ext.YMax)
            got_any = True

    if got_any and xmin < xmax and ymin < ymax:
        return arcpy.Extent(xmin, ymin, xmax, ymax)
    return None

# ---------------------------------
# التحقق النهائي: السلكت + الزوم
# ---------------------------------
def final_select_and_zoom(layer_param, temp_layer, final_where, expected_count):
    selected_count = 0
    selected_on = None

    # طبّق على الطبقة الفعلية
    try:
        arcpy.management.SelectLayerByAttribute(layer_param, "NEW_SELECTION", final_where)
        selected_count = int(arcpy.management.GetCount(layer_param)[0])
        selected_on = layer_param
        arcpy.AddMessage(f"[تحقق] عدد المحدد في الطبقة الفعلية: {selected_count}")
    except Exception as e:
        arcpy.AddWarning(f"[تحقق] تعذر تطبيق السلكت على الطبقة الفعلية: {e}")

    # لو فشل، طبّق على temp_layer
    if selected_count == 0:
        try:
            arcpy.management.SelectLayerByAttribute(temp_layer, "NEW_SELECTION", final_where)
            selected_count = int(arcpy.management.GetCount(temp_layer)[0])
            selected_on = temp_layer
            arcpy.AddMessage(f"[تحقق] تم تطبيق السلكت على temp_layer. عدد المحدد: {selected_count}")
        except Exception as e:
            arcpy.AddWarning(f"[تحقق] تعذر تطبيق السلكت على temp_layer: {e}")

    if expected_count and selected_count != expected_count:
        arcpy.AddWarning(f"[تحقق] العدد المحدد ({selected_count}) لا يطابق العدد المتوقع ({expected_count}).")

    # Zoom
    try:
        aprx = arcpy.mp.ArcGISProject("CURRENT")
        view = aprx.activeView
        if not view:
            arcpy.AddWarning("[تحقق] لا يوجد View نشط لعمل Zoom.")
            return selected_count

        if selected_on is None:
            arcpy.AddWarning("[تحقق] لا يوجد Layer تم تطبيق السلكت عليه لعمل Zoom.")
            return selected_count

        ext = get_selection_extent(selected_on)
        if ext:
            view.camera.setExtent(ext)
            arcpy.AddMessage("[تحقق] تم عمل Zoom على التحديد بنجاح.")
        else:
            arcpy.AddWarning("[تحقق] تعذر حساب Extent للتحديد.")
    except Exception as z:
        arcpy.AddWarning(f"[تحقق] تعذر عمل Zoom: {z}")

    return selected_count

# ---------------------------------
# الدالة الرئيسية
# ---------------------------------
def main():
    try:
        # البارامترات (بدون طبقة)
        amana_name = arcpy.GetParameterAsText(0)
        parcel_input = arcpy.GetParameterAsText(1)
        plan_input = arcpy.GetParameterAsText(2)

        parcel_field = "SUBDIVISIONPARCELNUMBER"
        plan_field   = "SUBDIVISIONPLAN_ID"
        amana_field  = "AMANA_ID"

        # جلب الطبقة من الخريطة بالـ aliasname الثابت
        TARGET_ALIASNAME = "حدود قطع الأراضي"

        aprx = arcpy.mp.ArcGISProject("CURRENT")
        m = aprx.activeMap

        layer = get_layer_by_aliasname(m, TARGET_ALIASNAME)
        if not layer:
            arcpy.AddError(f"لم يتم العثور على طبقة aliasname = '{TARGET_ALIASNAME}' داخل Contents.")
            arcpy.AddMessage("تلميح: تحققي من aliasname عبر Describe(layer).aliasname.")
            return

        arcpy.AddMessage(f"تم التعرف على الطبقة تلقائياً: {layer.name} | aliasname={arcpy.Describe(layer).aliasname}")

        # AMANA_ID
        amana_id = get_amana_id(amana_name)
        if not amana_id:
            arcpy.AddError("لم يتم التعرف على الأمانة المختارة")
            return

        parcel_clean = normalize_text(parcel_input)
        plan_clean   = normalize_text(plan_input)

        arcpy.AddMessage(f"الأمانة المختارة: {amana_name}")
        arcpy.AddMessage(f"AMANA_ID المستخدم: {amana_id}")
        arcpy.AddMessage(f"Parcel Clean: {parcel_clean}")
        arcpy.AddMessage(f"Plan Clean: {plan_clean}")

        # فهرسة (محاولة فقط)
        ensure_index(layer, amana_field)
        ensure_index(layer, parcel_field)
        ensure_index(layer, plan_field)

        # Layer مؤقت
        temp_layer = "temp_layer"
        if arcpy.Exists(temp_layer):
            arcpy.management.Delete(temp_layer)

        arcpy.management.MakeFeatureLayer(layer, temp_layer)

        # SQL بالأمانة
        sql = f"{amana_field} = '{amana_id}'"
        arcpy.management.SelectLayerByAttribute(temp_layer, "NEW_SELECTION", sql)

        count_sql = int(arcpy.management.GetCount(temp_layer)[0])
        arcpy.AddMessage(f"عدد النتائج بعد SQL الأولي: {count_sql}")

        if count_sql == 0:
            arcpy.AddWarning("لا توجد سجلات لهذه الأمانة")
            show_simple_window(0)
            return

        # تقليل النتائج إذا المخطط أرقام فقط
        plan_is_digits_only = plan_clean.isdigit()
        if plan_is_digits_only and plan_clean:
            try:
                sql2 = f"{amana_field} = '{amana_id}' AND {plan_field} LIKE '%{plan_clean}%'"
                arcpy.management.SelectLayerByAttribute(temp_layer, "NEW_SELECTION", sql2)
                count_sql2 = int(arcpy.management.GetCount(temp_layer)[0])
                arcpy.AddMessage(f"عدد النتائج بعد تصفية LIKE للمخطط: {count_sql2}")
            except Exception as e:
                arcpy.AddWarning(f"تعذر تطبيق LIKE على {plan_field} (سيتم المتابعة بدونها): {e}")

        # البحث الذكي
        oid_field = arcpy.Describe(temp_layer).OIDFieldName
        matched_oids = []

        with arcpy.da.SearchCursor(temp_layer, [oid_field, parcel_field, plan_field]) as cursor:
            for oid, parcel_val, plan_val in cursor:
                parcel_db = normalize_text(parcel_val)
                plan_db   = normalize_text(plan_val)

                if plan_is_digits_only:
                    if plan_clean and (plan_clean in plan_db):
                        if parcel_db == parcel_clean or parcel_db.startswith(parcel_clean):
                            matched_oids.append(oid)
                else:
                    if similarity(parcel_clean, parcel_db) >= 0.5 and similarity(plan_clean, plan_db) >= 0.5:
                        matched_oids.append(oid)

        if not matched_oids:
            arcpy.AddWarning("لا توجد نتائج مطابقة بعد المعالجة")
            show_simple_window(0)
            return

        # WHERE النهائي
        oid_list = ",".join(map(str, matched_oids))
        final_where = f"{oid_field} IN ({oid_list})"

        # تحقق نهائي: سلكت + زوم على الطبقة الفعلية
        verified_selected = final_select_and_zoom(layer, temp_layer, final_where, len(matched_oids))

        arcpy.AddMessage(f"تم العثور على {len(matched_oids)} قطعة. المحدد فعليًا بعد التحقق: {verified_selected}")
        show_simple_window(verified_selected)

    except Exception as e:
        arcpy.AddError(str(e))

if __name__ == "__main__":
    main()
