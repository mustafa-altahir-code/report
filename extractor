        ) || "20px",
      zIndex: "2147483647"
    });

    const button =
      document.createElement("button");

    button.id =
      CONFIG.buttonId;

    button.textContent = "📥";

    button.title =
      "اضغط لاستخراج البيانات ونسخها إلى Excel";

    Object.assign(button.style, {
      width: "54px",
      height: "54px",
      borderRadius: "50%",
