  /* ============================================================
   * نسخ Excel — عمودين فقط
   * ============================================================ */

  async function copyToExcel(data) {
    const rows = [];

    /* رأس الجدول */
    rows.push([
      "الحقل",
      "القيمة"
    ]);

    for (const [field, value] of Object.entries(data)) {
      rows.push([
        String(field || ""),
        String(value || "")
      ]);
    }

    const text = rows
      .map(row =>
        row
          .map(value =>
            String(value)
              .replace(/\t/g, " ")
              .replace(/\r?\n/g, " ")
          )
          .join("\t")
      )
      .join("\r\n");

    try {
      await navigator.clipboard.writeText(text);
    } catch (e) {
      const textarea = document.createElement("textarea");

      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";

      document.body.appendChild(textarea);

      textarea.select();

      document.execCommand("copy");

      textarea.remove();
    }

    return text;
  }

