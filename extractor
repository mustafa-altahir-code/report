  /* ============================================================
   * الزر
   * ============================================================ */

  function createButton() {
    if (
      document.getElementById(CONFIG.containerId)
    ) {
      return;
    }

    const container =
      document.createElement("div");

    container.id =
      CONFIG.containerId;

    Object.assign(container.style, {
      position: "fixed",
      left:
        localStorage.getItem(
          "propertyExtractorLeft"
        ) || "20px",
      bottom:
        localStorage.getItem(
          "propertyExtractorBottom"
        ) || "20px",
      zIndex: "2147483647"
    });

    const button =
      document.createElement("button");

    button.id =
      CONFIG.buttonId;

    button.textContent = "📥";

    button.title =
      "اضغط لاستخراج البيانات ونسخها إلى Excel";

    Object.assign(button.style, {
      width: "54px",
      height: "54px",
      borderRadius: "50%",
      border: "0",
      background: "#ffffff",
      color: "#087f5b",
      fontSize: "24px",
      cursor: "grab",
      boxShadow: "0 4px 15px rgba(0,0,0,.2)",
      display: "flex",
      alignItems: "center",
      justifyContent: "center"
    });

    /* ========================================================
     * السحب
     * ======================================================== */

    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startBottom = 0;

    button.addEventListener(
      "pointerdown",
      event => {
        if (event.button !== 0) return;

        dragging = true;
        moved = false;

        startX = event.clientX;
        startY = event.clientY;

        const rect =
          container.getBoundingClientRect();

        startLeft = rect.left;
        startBottom =
          window.innerHeight -
          rect.bottom;

        button.style.cursor = "grabbing";

        button.setPointerCapture(
          event.pointerId
        );
      }
    );

    button.addEventListener(
      "pointermove",
      event => {
        if (!dragging) return;

        const dx =
          event.clientX - startX;

        const dy =
          event.clientY - startY;

        if (
          Math.abs(dx) > 4 ||
          Math.abs(dy) > 4
        ) {
          moved = true;
        }

        let left =
          startLeft + dx;

        let bottom =
          startBottom - dy;

        left = Math.max(
          0,
          Math.min(
            left,
            window.innerWidth -
              container.offsetWidth
          )
        );

        bottom = Math.max(
          0,
          Math.min(
            bottom,
            window.innerHeight -
              container.offsetHeight
          )
        );

        container.style.left =
          `${left}px`;

        container.style.bottom =
          `${bottom}px`;
      }
    );

    button.addEventListener(
      "pointerup",
      event => {
        if (!dragging) return;

        dragging = false;

        button.style.cursor = "grab";

        const rect =
          container.getBoundingClientRect();

        localStorage.setItem(
          "propertyExtractorLeft",
          `${rect.left}px`
        );

        localStorage.setItem(
          "propertyExtractorBottom",
          `${window.innerHeight - rect.bottom}px`
        );

        try {
          button.releasePointerCapture(
            event.pointerId
          );
        } catch {}
      }
    );

    /* ========================================================
     * الضغط
     * ======================================================== */

    button.addEventListener(
      "click",
      async () => {
        if (moved) {
          moved = false;
          return;
        }

        if (button.disabled) return;

        button.disabled = true;

        button.textContent = "⏳";

        try {
          const data =
            await extractAllData();

          const count =
            Object.values(data)
              .filter(
                value =>
                  value &&
                  value !== "N/A"
              ).length;

          if (!count) {
            throw new Error(
              "لم يتم العثور على أي بيانات."
            );
          }

          await copyToExcel(data);

          /* ========================================================
           * الانتقال إلى صفحة تفاصيل الصك
           * ======================================================== */

          const deedDetailsBtn = [...document.querySelectorAll("div,button")]
            .find(el => {
              const text = cleanText(el.textContent);

              return (
                text === "تفاصيل الصك" &&
                (
                  el.classList.contains("cursor-pointer") ||
                  el.tagName === "BUTTON" ||
                  el.querySelector(".cursor-pointer")
                )
              );
            });

          if (!deedDetailsBtn) {
            throw new Error(
              "زر تفاصيل الصك غير موجود في الصفحة الحالية"
            );
          }

          const clickable =
            deedDetailsBtn.classList.contains("cursor-pointer")
              ? deedDetailsBtn
              : deedDetailsBtn.querySelector(".cursor-pointer") ||
                deedDetailsBtn;

          clickable.scrollIntoView({
            behavior: "instant",
            block: "center"
          });

          await wait(300);

          clickable.dispatchEvent(
            new PointerEvent("pointerdown", {
              bubbles: true,
              cancelable: true,
              view: window,
              pointerId: 1,
              pointerType: "mouse",
              isPrimary: true,
              buttons: 1
            })
          );

          clickable.dispatchEvent(
            new MouseEvent("mousedown", {
              bubbles: true,
              cancelable: true,
              view: window,
              buttons: 1
            })
          );

          clickable.dispatchEvent(
            new PointerEvent("pointerup", {
              bubbles: true,
              cancelable: true,
              view: window,
              pointerId: 1,
              pointerType: "mouse",
              isPrimary: true,
              buttons: 0
            })
          );

          clickable.dispatchEvent(
            new MouseEvent("mouseup", {
              bubbles: true,
              cancelable: true,
              view: window,
              buttons: 0
            })
          );

          clickable.click();

          let ownerPageReady = false;

          for (let attempt = 0; attempt < 20; attempt++) {
            await wait(500);

            const ownerIdentity =
              document.querySelectorAll("td, p, span");

            const hasIdentity = [...ownerIdentity].some(el =>
              /^\d{10}$/.test(cleanText(el.textContent))
            );

            const hasOwnerName = [
              ...document.querySelectorAll(
                "td p.font-bold, td p[class*='font-bold'], td p[class*='text-[#4A6BA3]']"
              )
            ].some(el => {
              const text = cleanText(el.textContent);

              return (
                text.length > 2 &&
                /[\u0600-\u06FF]/.test(text) &&
                !/^\d+$/.test(text) &&
                !text.includes("المالك")
              );
            });

            if (hasIdentity || hasOwnerName) {
              ownerPageReady = true;
              break;
            }
          }

          const ownerData = extractOwnerData();
          const deedData = extractDeedData();

          Object.assign(
            data,
            ownerData,
            deedData
          );

          await copyToExcel(data);

          showResult(data);

          button.textContent = "✅";

          button.style.color =
            "#16a34a";

        } catch (error) {
          button.textContent =
            "❌";

          button.style.color =
            "#dc2626";

          alert(
            "حدث خطأ أثناء استخراج البيانات:\n\n" +
            error.message
          );

        } finally {
          setTimeout(() => {
            button.textContent =
              "📥";

            button.style.color =
              "#087f5b";

            button.disabled =
              false;
          }, 2500);
        }
      }
    );

    container.appendChild(button);

    document.body.appendChild(container);
  }

  /* ============================================================
   * تشغيل
   * ============================================================ */

  function init() {
    if (!document.body) {
      setTimeout(init, 500);
      return;
    }
 
    createButton();
  }

  init();

})();
