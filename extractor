      background: "#ffffff",
      color: "#087f5b",
      fontSize: "24px",
      cursor: "grab",
      boxShadow: "0 4px 15px rgba(0,0,0,.2)",
      display: "flex",
      alignItems: "center",
      justifyContent: "center"
    });

    /* ========================================================
     * السحب
     * ======================================================== */

    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startBottom = 0;

    button.addEventListener(
      "pointerdown",
      event => {
        if (event.button !== 0) return;

        dragging = true;
        moved = false;

        startX = event.clientX;
        startY = event.clientY;

        const rect =
          container.getBoundingClientRect();

        startLeft = rect.left;
        startBottom =
          window.innerHeight -
          rect.bottom;

        button.style.cursor = "grabbing";

        button.setPointerCapture(
          event.pointerId
        );
      }
    );

    button.addEventListener(
      "pointermove",
      event => {
        if (!dragging) return;

        const dx =
          event.clientX - startX;

        const dy =
          event.clientY - startY;

        if (
          Math.abs(dx) > 4 ||
          Math.abs(dy) > 4
        ) {
          moved = true;
        }

        let left =
          startLeft + dx;

        let bottom =
          startBottom - dy;

        left = Math.max(
          0,
          Math.min(
            left,
            window.innerWidth -
              container.offsetWidth
          )
        );

        bottom = Math.max(
          0,
          Math.min(
            bottom,
            window.innerHeight -
              container.offsetHeight
          )
        );

        container.style.left =
          `${left}px`;

        container.style.bottom =
          `${bottom}px`;
      }
    );

    button.addEventListener(
      "pointerup",
      event => {
        if (!dragging) return;

        dragging = false;

        button.style.cursor = "grab";

        const rect =
          container.getBoundingClientRect();

        localStorage.setItem(
          "propertyExtractorLeft",
          `${rect.left}px`
        );

        localStorage.setItem(
          "propertyExtractorBottom",
          `${window.innerHeight - rect.bottom}px`
        );

        try {
          button.releasePointerCapture(
            event.pointerId
          );
        } catch {}
      }
    );

    /* ========================================================
     * الضغط
     * ======================================================== */

    button.addEventListener(
      "click",
