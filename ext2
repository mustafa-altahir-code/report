(() => {
  "use strict";

  /* ============================================================
   * التعبيرات النمطية والثوابت
   * ============================================================ */
  const APPLICATION_NUMBER_RE = /\bDU\d+\b/i;
  const DEED_NUM_RE = /^\d+[\/\\]\d+$/;
  const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
  const IDENTITY_RE = /^\d{10}$/;
  const ARABIC_RE = /[\u0600-\u06FF]/;
  const COORD_N_RE = /^الإحداثي الشمالي \(N\) (\d+)$/;
  const COORD_E_RE = /^الإحداثي الشرقي \(E\) (\d+)$/;

  const FINAL_FIELD_ORDER = [
    "رقم الطلب",
    "رقم صك وزارة العدل",
    "تاريخ الصك",
    "اسم المالك",
    "رقم الهوية",
    "رقم السجل العقاري",
    "رقم القطعة بالمخطط",
    "رقم المخطط",
    "رقم البلوك",
    "اسم الحي",
    "اسم المدينة",
    "الحدود حسب طبقة الأراضي",
    "الحدود حسب الصك",
    "وصف العقار",
    "اتجاه 1",
    "الحدود حسب الصك 1",
    "الحدود حسب الطبيعة 1",
    "الأبعاد حسب الصك (طول الضلع) 1",
    "الأبعاد حسب الصك (المجموع) 1",
    "الأبعاد حسب طبقة الأراضي (طول الضلع) 1",
    "الأبعاد حسب طبقة الأراضي (المجموع) 1",
    "اتجاه 2",
    "الحدود حسب الصك 2",
    "الحدود حسب الطبيعة 2",
    "الأبعاد حسب الصك (طول الضلع) 2",
    "الأبعاد حسب الصك (المجموع) 2",
    "الأبعاد حسب طبقة الأراضي (طول الضلع) 2",
    "الأبعاد حسب طبقة الأراضي (المجموع) 2",
    "اتجاه 3",
    "الحدود حسب الصك 3",
    "الحدود حسب الطبيعة 3",
    "الأبعاد حسب الصك (طول الضلع) 3",
    "الأبعاد حسب الصك (المجموع) 3",
    "الأبعاد حسب طبقة الأراضي (طول الضلع) 3",
    "الأبعاد حسب طبقة الأراضي (المجموع) 3",
    "اتجاه 4",
    "الحدود حسب الصك 4",
    "الحدود حسب الطبيعة 4",
    "الأبعاد حسب الصك (طول الضلع) 4",
    "الأبعاد حسب الصك (المجموع) 4",
    "الأبعاد حسب طبقة الأراضي (طول الضلع) 4",
    "الأبعاد حسب طبقة الأراضي (المجموع) 4",
    "النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي"
  ];

  /* ============================================================
   * الدوال المساعدة
   * ============================================================ */
  const cleanText = (value) =>
    String(value ?? "")
      .replace(/\u00a0/g, " ")
      .replace(/\s+/g, " ")
      .trim();

  const wait = (ms) => new Promise((r) => setTimeout(r, ms));

  function findInputByPlaceholder(placeholderText, excludeNamePart = null) {
    const inputs = document.querySelectorAll("input, textarea");
    for (const el of inputs) {
      const ph = cleanText(el.placeholder || el.getAttribute("placeholder") || "");
      if (ph === placeholderText || ph.includes(placeholderText)) {
        if (excludeNamePart && (el.name || "").includes(excludeNamePart)) {
          continue;
        }
        return el;
      }
    }
    return null;
  }

  /* ============================================================
   * دوال الاستخراج الذكية والمحدثة
   * ============================================================ */

  /**
   * استخراج رقم الطلب (DU...)
   */
  function extractApplicationNumber() {
    const selectors = [
      "div.my-6.flex.justify-between:nth-child(5) span.uppercase",
      "div.my-6.flex.justify-between span.uppercase",
      "span.uppercase.text-\\[12px\\]",
      "span.uppercase",
      "div.inner-container span.uppercase"
    ];

    for (const sel of selectors) {
      try {
        const el = document.querySelector(sel);
        if (el) {
          const text = cleanText(el.textContent);
          const match = text.match(APPLICATION_NUMBER_RE);
          if (match) return match[0].toUpperCase();
        }
      } catch (e) {}
    }

    const elements = document.querySelectorAll("span, p, div, td");
    for (const el of elements) {
      const txt = el.textContent || "";
      if (txt.length < 150 && APPLICATION_NUMBER_RE.test(txt)) {
        const match = cleanText(txt).match(APPLICATION_NUMBER_RE);
        if (match) return match[0].toUpperCase();
      }
    }

    return "";
  }

  /**
   * استخراج بيانات الصك: رقم صك وزارة العدل وتاريخ الصك
   */
  function extractDeedData() {
    const data = {
      "رقم صك وزارة العدل": "",
      "تاريخ الصك": ""
    };

    const tables = document.querySelectorAll(
      "table.borderTable-new, table[class*='borderTable-new'], div.mt-2 table, table"
    );

    for (const table of tables) {
      const isNewBorderTable = (table.className || "").includes("borderTable-new");
      const rows = table.querySelectorAll("tbody tr, tr");

      for (const row of rows) {
        const cells = [...row.querySelectorAll("td")]
          .map((c) => cleanText(c.textContent))
          .filter(Boolean);

        if (!cells.length) continue;

        const dateIndex = cells.findIndex((v) => DATE_RE.test(v));
        const deedIndex = cells.findIndex((v) => DEED_NUM_RE.test(v));

        if (deedIndex !== -1 && !data["رقم صك وزارة العدل"]) {
          data["رقم صك وزارة العدل"] = cells[deedIndex];
        }
        if (dateIndex !== -1 && !data["تاريخ الصك"]) {
          data["تاريخ الصك"] = cells[dateIndex];
        }

        if (isNewBorderTable) {
          if (!data["رقم صك وزارة العدل"] && cells[0]) {
            data["رقم صك وزارة العدل"] = cells[0];
          }
          if (!data["تاريخ الصك"] && cells[1]) {
            data["تاريخ الصك"] = cells[1];
          }
        }

        if (data["رقم صك وزارة العدل"] && data["تاريخ الصك"]) {
          return data;
        }
      }
    }

    if (!data["رقم صك وزارة العدل"]) {
      for (const el of document.querySelectorAll("td, span, p, div")) {
        const txt = cleanText(el.textContent);
        if (txt.length < 50 && DEED_NUM_RE.test(txt) && !txt.includes("14") && !txt.includes("202")) {
          data["رقم صك وزارة العدل"] = txt;
          break;
        }
      }
    }

    if (!data["تاريخ الصك"]) {
      for (const el of document.querySelectorAll("td, span, p, div")) {
        const txt = cleanText(el.textContent);
        if (txt.length < 30 && DATE_RE.test(txt)) {
          data["تاريخ الصك"] = txt;
          break;
        }
      }
    }

    return data;
  }

  /**
   * استخراج بيانات المالك: اسم المالك ورقم الهوية
   */
  function extractOwnerData() {
    const data = {
      "اسم المالك": "",
      "رقم الهوية": ""
    };

    const tables = document.querySelectorAll(
      "div.pb-6 table, table.borderTable, table[class*='borderTable']"
    );

    for (const table of tables) {
      if ((table.className || "").includes("borderTable-new")) continue;

      const boldP = table.querySelector(
        "td p.font-bold, td p[class*='font-bold'], td p[class*='text-[#4A6BA3]']"
      );
      if (boldP) {
        const txt = cleanText(boldP.textContent);
        if (txt && ARABIC_RE.test(txt) && !/^\d+$/.test(txt)) {
          data["اسم المالك"] = txt;
        }
      }

      const cells = table.querySelectorAll("td");
      for (const cell of cells) {
        const txt = cleanText(cell.textContent);
        if (IDENTITY_RE.test(txt)) {
          data["رقم الهوية"] = txt;
          break;
        }
      }

      if (!data["اسم المالك"]) {
        const rows = table.querySelectorAll("tbody tr, tr");
        for (const row of rows) {
          const rowCells = row.querySelectorAll("td");
          if (rowCells.length >= 1) {
            const txt = cleanText(rowCells[0].textContent);
            if (txt && ARABIC_RE.test(txt) && !/^\d+$/.test(txt) && !txt.includes("المالك")) {
              data["اسم المالك"] = txt;
              break;
            }
          }
        }
      }

      if (data["اسم المالك"] && data["رقم الهوية"]) return data;
    }

    if (!data["اسم المالك"]) {
      const candidates = document.querySelectorAll(
        "td p.font-bold, td p[class*='text-[#4A6BA3]']"
      );
      for (const p of candidates) {
        const txt = cleanText(p.textContent);
        if (txt && txt.length > 5 && ARABIC_RE.test(txt) && !/^\d+$/.test(txt)) {
          data["اسم المالك"] = txt;
          break;
        }
      }
    }

    if (!data["رقم الهوية"]) {
      const cells = document.querySelectorAll("td, p[class*='text-[12px]']");
      for (const c of cells) {
        const txt = cleanText(c.textContent);
        if (IDENTITY_RE.test(txt)) {
          data["رقم الهوية"] = txt;
          break;
        }
      }
    }

    return data;
  }

  /**
   * استخراج البيانات الأساسية للعقار
   */
  function extractBasicData() {
    const data = {
      "رقم السجل العقاري": "",
      "رقم القطعة بالمخطط": "",
      "رقم المخطط": "",
      "رقم البلوك": "",
      "اسم الحي": "",
      "اسم المدينة": "",
      "الحدود حسب طبقة الأراضي": "",
      "الحدود حسب الصك": "",
      "وصف العقار": "",
      "النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي": ""
    };

    const plotEl = findInputByPlaceholder("رقم القطعة بالمخطط");
    if (plotEl) data["رقم القطعة بالمخطط"] = cleanText(plotEl.value);

    const planEl = findInputByPlaceholder("رقم المخطط");
    if (planEl) data["رقم المخطط"] = cleanText(planEl.value);

    const blockEl = findInputByPlaceholder("رقم البلوك");
    if (blockEl) data["رقم البلوك"] = cleanText(blockEl.value);

    const registryEl = findInputByPlaceholder("رقم السجل العقاري");
    if (registryEl) data["رقم السجل العقاري"] = cleanText(registryEl.value);

    const landAreaEl = findInputByPlaceholder("الحدود حسب طبقة الأراضي");
    if (landAreaEl) data["الحدود حسب طبقة الأراضي"] = cleanText(landAreaEl.value);

    const deedAreaEl = findInputByPlaceholder("الحدود حسب الصك", "directions");
    if (deedAreaEl) data["الحدود حسب الصك"] = cleanText(deedAreaEl.value);

    const descEl = document.querySelector(
      'textarea[name="description"], textarea[placeholder="وصف العقار"], textarea'
    );
    if (descEl) data["وصف العقار"] = cleanText(descEl.value);

    const utmEl =
      findInputByPlaceholder("النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي") ||
      findInputByPlaceholder("مركاتور");
    if (utmEl) data["النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي"] = cleanText(utmEl.value);

    const labels = document.querySelectorAll("label, span, div, p");
    for (const label of labels) {
      const txt = cleanText(label.textContent);
      if (!data["اسم المدينة"] && (txt === "المدينة" || txt === "اسم المدينة")) {
        const parent = label.closest("div") || label.parentElement;
        const sv = parent?.querySelector('[class*="singleValue"]');
        if (sv) data["اسم المدينة"] = cleanText(sv.textContent);
      }
      if (!data["اسم الحي"] && (txt === "الحي" || txt === "اسم الحي")) {
        const parent = label.closest("div") || label.parentElement;
        const sv = parent?.querySelector('[class*="singleValue"]');
        if (sv) data["اسم الحي"] = cleanText(sv.textContent);
      }
    }

    if (!data["اسم المدينة"] || !data["اسم الحي"]) {
      if (plotEl) {
        const grid = plotEl.closest(".grid") || plotEl.closest('[class*="grid"]');
        if (grid && grid.children) {
          if (!data["اسم المدينة"] && grid.children.length > 5) {
            const sv = grid.children[5].querySelector('[class*="singleValue"]');
            if (sv) data["اسم المدينة"] = cleanText(sv.textContent);
          }
          if (!data["اسم الحي"] && grid.children.length > 6) {
            const sv = grid.children[6].querySelector('[class*="singleValue"]');
            if (sv) data["اسم الحي"] = cleanText(sv.textContent);
          }
        }
      }
    }

    return data;
  }

  /**
   * استخراج بيانات الاتجاهات الأربعة وأبعادها وحدودها
   */
  function extractDirections() {
    const data = {};
    const defaultDirections = ["الشمالية", "الجنوبية", "الشرقية", "الغربية"];

    const fieldMap = {
      deedBoundry: "الحدود حسب الصك",
      asBuiltBoundry: "الحدود حسب الطبيعة",
      deedDimentionLength: "الأبعاد حسب الصك (طول الضلع)",
      deedDimentionTotal: "الأبعاد حسب الصك (المجموع)",
      asBuiltDimentionLength: "الأبعاد حسب طبقة الأراضي (طول الضلع)",
      asBuiltDimentionTotal: "الأبعاد حسب طبقة الأراضي (المجموع)"
    };

    for (let i = 0; i < 4; i++) {
      const n = i + 1;
      let dirName = "";

      const anyInput = document.querySelector(`input[name*="directions.${i}."]`);
      if (anyInput) {
        const container =
          anyInput.closest("div.grid") ||
          anyInput.closest('[class*="grid"]') ||
          anyInput.parentElement?.parentElement;
        if (container) {
          const sv = container.querySelector('[class*="singleValue"]');
          if (sv) dirName = cleanText(sv.textContent);
        }
      }

      if (!dirName) {
        const hidden = document.querySelector(`input[name="directions.${i}.direction"]`);
        if (hidden) {
          const parent = hidden.parentElement;
          const sv = parent?.querySelector('[class*="singleValue"]');
          dirName = cleanText(sv?.textContent || hidden.value);
        }
      }

      data[`اتجاه ${n}`] = dirName || defaultDirections[i] || "";

      for (const [namePart, labelPrefix] of Object.entries(fieldMap)) {
        const input = document.querySelector(`input[name="directions.${i}.${namePart}"]`);
        data[`${labelPrefix} ${n}`] = input ? cleanText(input.value) : "";
      }
    }

    return data;
  }

  /**
   * استخراج الإحداثيات
   */
  function extractCoordinates() {
    const data = {};
    const groups = {};

    document
      .querySelectorAll('input[name*="coordinates."]')
      .forEach((input) => {
        const name = input.getAttribute("name") || "";
        const match = name.match(
          /coordinates\.(\d+)\.(northCordinate|eastCordinate|northCoordinate|eastCoordinate|north|east)/i
        );
        if (!match) return;

        const index = Number(match[1]);
        let type = match[2].toLowerCase();
        if (type.includes("north")) type = "north";
        else if (type.includes("east")) type = "east";

        if (!groups[index]) groups[index] = {};
        groups[index][type] = cleanText(input.value);
      });

    const indices = Object.keys(groups).map(Number).sort((a, b) => a - b);

    indices.forEach((index, position) => {
      const group = groups[index] || {};
      const n = position + 1;
      data[`الإحداثي الشمالي (N) ${n}`] = group.north || "";
      data[`الإحداثي الشرقي (E) ${n}`] = group.east || "";
    });

    return data;
  }

  /**
   * بناء كائن البيانات النهائي بنفس الترتيب المطلوب في نظام التقرير
   */
  function buildFinalData(allData) {
    const coordMap = new Map();

    for (const [key, value] of Object.entries(allData)) {
      let match = key.match(COORD_N_RE);
      if (match) {
        const idx = Number(match[1]);
        if (!coordMap.has(idx)) coordMap.set(idx, { n: "", e: "" });
        coordMap.get(idx).n = value;
        continue;
      }

      match = key.match(COORD_E_RE);
      if (match) {
        const idx = Number(match[1]);
        if (!coordMap.has(idx)) coordMap.set(idx, { n: "", e: "" });
        coordMap.get(idx).e = value;
      }
    }

    const finalKeys = [...FINAL_FIELD_ORDER];

    const sortedCoordIndices = [...coordMap.keys()].sort((a, b) => a - b);
    sortedCoordIndices.forEach((idx) => {
      finalKeys.push(`الإحداثي الشمالي (N) ${idx}`);
      finalKeys.push(`الإحداثي الشرقي (E) ${idx}`);
    });

    const finalData = {};
    finalKeys.forEach((k) => {
      const value = allData[k];
      finalData[k] = cleanText(value) || "N/A";
    });

    return finalData;
  }

  /**
   * الاستخراج الشامل للبيانات من الصفحة مع إعادة المحاولة الذكية
   */
  async function extractAllData() {
    const hasDeedTable = Boolean(document.querySelector('table[class*="borderTable"]'));
    if (!hasDeedTable) {
      const deedButton = [...document.querySelectorAll("button, div.cursor-pointer, a, span")].find(
        (el) => cleanText(el.textContent) === "تفاصيل الصك"
      );
      if (deedButton) {
        deedButton.click();
        await wait(800);
      }
    }

    const merged = {
      "رقم الطلب": extractApplicationNumber(),
      ...extractBasicData(),
      ...extractDeedData(),
      ...extractOwnerData(),
      ...extractDirections(),
      ...extractCoordinates()
    };

    const requiredCheck = [
      "رقم صك وزارة العدل",
      "تاريخ الصك",
      "اسم المالك",
      "رقم الهوية",
      "رقم القطعة بالمخطط"
    ];

    let attempts = 0;
    while (attempts < 3 && requiredCheck.some((f) => !cleanText(merged[f] || ""))) {
      attempts++;
      await wait(600);

      const retryDeed = extractDeedData();
      const retryOwner = extractOwnerData();
      const retryBasic = extractBasicData();
      const retryApp = { "رقم الطلب": extractApplicationNumber() };

      for (const obj of [retryDeed, retryOwner, retryBasic, retryApp]) {
        for (const [key, value] of Object.entries(obj)) {
          if (cleanText(value) && !cleanText(merged[key] || "")) {
            merged[key] = value;
          }
        }
      }
    }

    return buildFinalData(merged);
  }

  /**
   * النسخ إلى الحافظة بصيغة جدول تفصل بينه علامات Tab
   */
  async function copyToClipboard(data) {
    const rows = [["الحقل", "القيمة"]];
    for (const [key, value] of Object.entries(data)) {
      rows.push([String(key ?? ""), String(value ?? "")]);
    }

    const text = rows
      .map((row) =>
        row
          .map((value) =>
            String(value).replace(/\t/g, " ").replace(/\r?\n/g, " ")
          )
          .join("\t")
      )
      .join("\r\n");

    await navigator.clipboard.writeText(text);
    return text;
  }

  /* ============================================================
   * ⚡ دوال التعبئة التلقائية المحدثة (عند الضغط باليمين)
   * ============================================================ */

  /**
   * تحليل بيانات الحافظة سواء بصيغة المسح الإنجليزي (CAD) أو بصيغة التقرير العربي
   */
  function parseClipboardData(text) {
    if (!text) return null;

    const lines = text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean);

    const result = {
      lot: "",
      plan: "",
      block: "",
      zone: "",
      area: "",
      totalLength: "",
      deedArea: "",
      description: "",
      coordinates: [],
      directions: {}
    };

    let section = "header";

    for (const line of lines) {
      const upper = line.toUpperCase();

      if (upper === "COORDINATES" || upper.includes("الإحداثيات")) {
        section = "coordinates";
        continue;
      }
      if (upper === "DIRECTION SUMMARY" || upper.includes("ملخص الاتجاهات")) {
        section = "directions";
        continue;
      }

      const parts = line.split(/\t+/).map((p) => p.trim()).filter(Boolean);

      // قسم الإحداثيات
      if (section === "coordinates") {
        if (upper.startsWith("VERTEX") || upper.includes("النقطة")) continue;
        if (parts.length >= 3) {
          const n = parseFloat(parts[1]);
          const e = parseFloat(parts[2]);
          if (!isNaN(n) && !isNaN(e)) {
            result.coordinates.push({ n: parts[1], e: parts[2] });
          }
        }
        continue;
      }

      // قسم ملخص الاتجاهات
      if (section === "directions") {
        if (parts.length >= 2) {
          const dir = parts[0].toUpperCase();
          let value = parts.length > 2 ? parts.slice(1).join(" ") : parts[1];
          const cleaned = value.replace(/\s*m\s*$/i, "").trim();
          let total = cleaned;
          let side = cleaned;

          const totalMatch = cleaned.match(/=\s*([\d.]+)/);
          if (totalMatch) {
            total = totalMatch[1];
            side = cleaned.split("=")[0].trim().replace(/\s*m\s*$/i, "").trim();
          }

          if (dir === "NORTH" || dir.includes("شمال")) result.directions.north = { side, total };
          else if (dir === "EAST" || dir.includes("شرق")) result.directions.east = { side, total };
          else if (dir === "SOUTH" || dir.includes("جنوب")) result.directions.south = { side, total };
          else if (dir === "WEST" || dir.includes("غرب")) result.directions.west = { side, total };
        }
        continue;
      }

      // القسم العام (يدعم الإنجليزية والعربية)
      if (parts.length >= 2) {
        const key = parts[0].toUpperCase();
        const value = parts[1];

        if (key === "LOT" || key.includes("القطعة")) result.lot = value;
        else if (key === "PLAN" || (key.includes("المخطط") && !key.includes("القطعة"))) result.plan = value;
        else if (key === "BLOCK" || key.includes("البلوك")) result.block = value;
        else if (key === "ZONE" || key.includes("النطاق") || key.includes("مركاتور")) result.zone = value;
        else if (key === "AREA" || key.includes("طبقة الأراضي")) {
          result.area = value.replace(/\s*m2?\s*$/i, "").trim();
        } else if (key === "TOTAL LENGTH" || key === "TOTAL_LENGTH") {
          result.totalLength = value.replace(/\s*m\s*$/i, "").trim();
        } else if (key === "الحدود حسب الصك") {
          result.deedArea = value;
        } else if (key.includes("وصف العقار")) {
          result.description = value;
        }
      }
    }

    return result;
  }

  /**
   * تعيين قيمة لأي حقل مدخل في React مع تحديث الـ State الخاص به
   */
  function setNativeValue(el, value) {
    if (!el) return false;

    const stringValue = String(value ?? "");

    el.focus();

    // إذا كان الحقل يقبل أرقام فقط والقيمة تحتوي على نص أو رموز (مثل +)، نحول النوع إلى text
    if (el.type === "number" && /[^\d.]/.test(stringValue)) {
      el.type = "text";
    }

    const proto =
      el instanceof HTMLTextAreaElement
        ? HTMLTextAreaElement.prototype
        : HTMLInputElement.prototype;

    const setter = Object.getOwnPropertyDescriptor(proto, "value")?.set;

    // إعادة تعيين tracker القيمة الخاص بـ React
    const tracker = el._valueTracker;
    if (tracker) {
      tracker.setValue(stringValue === "" ? "a" : "");
    }

    if (setter) {
      setter.call(el, stringValue);
    } else {
      el.value = stringValue;
    }

    el.dispatchEvent(
      new InputEvent("input", {
        bubbles: true,
        cancelable: true,
        inputType: "insertText",
        data: stringValue
      })
    );

    el.dispatchEvent(new Event("change", { bubbles: true }));
    el.dispatchEvent(new Event("blur", { bubbles: true }));

    return el.value === stringValue;
  }

  function key(el, k) {
    const codes = { ArrowDown: 40, Enter: 13 };
    const options = {
      key: k,
      code: k,
      keyCode: codes[k] || 0,
      which: codes[k] || 0,
      bubbles: true,
      cancelable: true
    };
    el.dispatchEvent(new KeyboardEvent("keydown", options));
    el.dispatchEvent(new KeyboardEvent("keypress", options));
    el.dispatchEvent(new KeyboardEvent("keyup", options));
  }

  /**
   * العثور على عنصر React-Select الخاص بالاتجاه رقم index في التصميم الجديد
   */
  function getDirectionCombobox(index) {
    // 1. عبر الحقول المدخلة للاتجاه نفسه
    const anyInput = document.querySelector(`input[name*="directions.${index}."]`);
    if (anyInput) {
      let parent = anyInput.parentElement;
      for (let step = 0; step < 6 && parent; step++) {
        const cb = parent.querySelector('input[role="combobox"], [class*="control"] input');
        if (cb) return cb;
        parent = parent.parentElement;
      }
    }

    // 2. عبر حاوية قسم الاتجاهات (div:nth-child(4))
    const dirContainer = document.querySelector(
      "div.space-y-10 > div:nth-child(4), div[class*='space-y'] > div:nth-child(4)"
    );
    if (dirContainer) {
      const rows = dirContainer.querySelectorAll(":scope > div");
      if (rows[index]) {
        const cb = rows[index].querySelector('input[role="combobox"], [class*="control"] input');
        if (cb) return cb;
      }
    }

    // 3. احتياطي: فحص عناصر combobox المحاطة بحقول directions
    const allCombos = [...document.querySelectorAll('input[role="combobox"]')];
    const dirCombos = allCombos.filter((c) => {
      const container = c.closest("div.grid") || c.parentElement?.parentElement;
      return container && container.querySelector('input[name*="directions."]');
    });
    if (dirCombos[index]) return dirCombos[index];

    return null;
  }

  /**
   * التعبئة الشاملة من بيانات الحافظة
   */
  async function fillFromClipboard() {
    let text = "";

    try {
      text = await navigator.clipboard.readText();
    } catch (error) {
      console.error("❌ تعذر قراءة الحافظة:", error);
      alert(
        "تعذر قراءة الحافظة.\n\nتأكد أن الصفحة هي النافذة النشطة ثم اضغط بالزر الأيمن مرة أخرى."
      );
      return false;
    }

    if (!text) {
      alert("الحافظة فارغة. انسخ بيانات الإضافة أولًا.");
      return false;
    }

    const parsed = parseClipboardData(text);
    if (!parsed) {
      alert("تعذر تحليل بيانات الحافظة.");
      return false;
    }

    // 1. الحقول البسيطة
    const simpleFields = [
      ["رقم القطعة بالمخطط", parsed.lot],
      ["رقم المخطط", parsed.plan],
      ["رقم البلوك", parsed.block],
      ["النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي", parsed.zone],
      ["الحدود حسب طبقة الأراضي", parsed.area],
      ["الحدود حسب الصك", parsed.deedArea]
    ];

    for (const [placeholder, value] of simpleFields) {
      if (!value) continue;
      const input = findInputByPlaceholder(
        placeholder,
        placeholder === "الحدود حسب الصك" ? "directions" : null
      );
      if (input) setNativeValue(input, value);
    }

    // وصف العقار
    if (parsed.description) {
      const descEl = document.querySelector(
        'textarea[name="description"], textarea[placeholder="وصف العقار"]'
      );
      if (descEl) setNativeValue(descEl, parsed.description);
    }

    // 2. الاتجاهات (React Select)
    const directionConfigs = [
      { name: "الشمالية", data: parsed.directions.north },
      { name: "الجنوبية", data: parsed.directions.south },
      { name: "الشرقية", data: parsed.directions.east },
      { name: "الغربية", data: parsed.directions.west }
    ];

    for (let i = 0; i < 4; i++) {
      const combobox = getDirectionCombobox(i);
      if (combobox) {
        combobox.focus();
        const dirArabic = directionConfigs[i].name;
        setNativeValue(combobox, dirArabic);
        await wait(60);
        key(combobox, "ArrowDown");
        await wait(60);
        key(combobox, "Enter");
        await wait(100);
      }
    }

    // 3. أبعاد طبقة الأراضي
    for (let i = 0; i < 4; i++) {
      const d = directionConfigs[i].data;
      if (!d) continue;

      const lengthInput = document.querySelector(
        `input[name="directions.${i}.asBuiltDimentionLength"]`
      );
      const totalInput = document.querySelector(
        `input[name="directions.${i}.asBuiltDimentionTotal"]`
      );

      if (lengthInput && String(d.side).includes("+")) {
        lengthInput.type = "text";
      }

      if (lengthInput) setNativeValue(lengthInput, d.side);
      if (totalInput) setNativeValue(totalInput, d.total);
    }

    // 4. الإحداثيات (مع إضافة صفوف إن لزم)
    const neededCoords = parsed.coordinates.length;
    if (neededCoords === 0) return true;

    function getCoordGroups() {
      const map = {};
      document.querySelectorAll('input[name*="coordinates."]').forEach((input) => {
        const match = input.name.match(
          /coordinates\.(\d+)\.(northCordinate|eastCordinate|northCoordinate|eastCoordinate|north|east)/i
        );
        if (!match) return;
        const i = Number(match[1]);
        if (!map[i]) map[i] = {};
        const type = match[2].toLowerCase();
        if (type.includes("north")) map[i].north = input;
        else if (type.includes("east")) map[i].east = input;
      });
      return map;
    }

    let groups = getCoordGroups();

    let safety = 0;
    while (Object.keys(groups).length < neededCoords && safety < 30) {
      safety++;
      const addBtn = [...document.querySelectorAll("button, a, div, span")].find((b) => {
        const txt = cleanText(b.textContent);
        return (
          txt.includes("إضافة المزيد من الإحداثيات") ||
          txt.includes("اضافة المزيد") ||
          txt.includes("+ إضافة")
        );
      });
      if (!addBtn) break;
      addBtn.click();

      for (let i = 0; i < 10; i++) {
        await wait(50);
        groups = getCoordGroups();
        if (Object.keys(groups).length >= neededCoords) break;
      }
    }

    const indices = Object.keys(groups).map(Number).sort((a, b) => a - b);
    for (let i = 0; i < neededCoords; i++) {
      const group = groups[indices[i]];
      if (!group) continue;
      const coord = parsed.coordinates[i];
      if (group.north && coord.n) setNativeValue(group.north, coord.n);
      if (group.east && coord.e) setNativeValue(group.east, coord.e);
    }

    return true;
  }

  /* ============================================================
   * زر الواجهة والتفاعل
   * ============================================================ */
  function createButton() {
    if (document.getElementById("property-csv-export-container")) return;

    const container = document.createElement("div");
    container.id = "property-csv-export-container";

    Object.assign(container.style, {
      position: "fixed",
      left: localStorage.getItem("propertyCsvButtonLeft") || "20px",
      bottom: localStorage.getItem("propertyCsvButtonBottom") || "20px",
      zIndex: "2147483647",
      userSelect: "none"
    });

    const button = document.createElement("button");
    button.id = "property-csv-export-button";
    button.textContent = "📥";
    button.title = "يسار: استخراج البيانات | يمين: تعبئة الحقول من الحافظة";
    button.setAttribute("data-mode", "extract");

    Object.assign(button.style, {
      width: "52px",
      height: "52px",
      padding: "0",
      background: "transparent",
      color: "#087f5b",
      border: "0",
      borderRadius: "50%",
      fontSize: "22px",
      fontFamily: "Arial, sans-serif",
      fontWeight: "bold",
      cursor: "grab",
      boxShadow: "none",
      display: "flex",
      alignItems: "center",
      justifyContent: "center"
    });

    button.addEventListener("mouseenter", () => {
      if (!button.disabled) button.style.background = "rgba(8,127,91,0.15)";
    });
    button.addEventListener("mouseleave", () => {
      if (!button.disabled) button.style.background = "transparent";
    });

    button.addEventListener("contextmenu", (e) => {
      e.preventDefault();
    });

    // السحب والإفلات
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startBottom = 0;
    let dragMoved = false;

    button.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      isDragging = true;
      dragMoved = false;
      button.style.cursor = "grabbing";
      startX = event.clientX;
      startY = event.clientY;

      const rect = container.getBoundingClientRect();
      startLeft = rect.left;
      startBottom = window.innerHeight - rect.bottom;

      button.setPointerCapture(event.pointerId);
    });

    button.addEventListener("pointermove", (event) => {
      if (!isDragging) return;

      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;

      if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) {
        dragMoved = true;
      }

      let newLeft = startLeft + deltaX;
      let newBottom = startBottom - deltaY;

      newLeft = Math.max(0, Math.min(newLeft, window.innerWidth - container.offsetWidth));
      newBottom = Math.max(0, Math.min(newBottom, window.innerHeight - container.offsetHeight));

      container.style.left = `${newLeft}px`;
      container.style.bottom = `${newBottom}px`;
    });

    button.addEventListener("pointerup", (event) => {
      if (!isDragging) return;
      isDragging = false;
      button.style.cursor = "grab";

      const rect = container.getBoundingClientRect();
      localStorage.setItem("propertyCsvButtonLeft", `${Math.max(0, rect.left)}px`);
      localStorage.setItem(
        "propertyCsvButtonBottom",
        `${Math.max(0, window.innerHeight - rect.bottom)}px`
      );

      try {
        button.releasePointerCapture(event.pointerId);
      } catch (e) {}
    });

    // الضغط بالزر الأيمن = تعبئة
    button.addEventListener("contextmenu", async (event) => {
      event.preventDefault();
      event.stopPropagation();

      if (button.disabled) return;

      button.disabled = true;
      button.textContent = "⏳";
      button.style.color = "#8E44AD";

      try {
        const success = await fillFromClipboard();
        if (success) {
          button.textContent = "✅";
          button.style.color = "#2f9e44";
        } else {
          button.textContent = "⚠️";
          button.style.color = "#F39C12";
        }
      } catch (error) {
        console.error("Fill Error:", error);
        alert("حدث خطأ أثناء التعبئة:\n\n" + error.message);
        button.textContent = "❌";
        button.style.color = "#c92a2a";
      }

      setTimeout(() => {
        button.textContent = "📥";
        button.style.color = "#087f5b";
        button.disabled = false;
      }, 2500);
    });

    // الضغط بالزر الأيسر = استخراج البيانات
    button.addEventListener("click", async () => {
      if (dragMoved) {
        dragMoved = false;
        return;
      }

      if (button.disabled) return;

      button.disabled = true;
      button.textContent = "⏳";

      try {
        const finalData = await extractAllData();

        const hasData = Object.values(finalData).some(
          (v) => cleanText(v) !== "" && cleanText(v) !== "N/A"
        );
        if (!hasData) {
          throw new Error("لم يتم العثور على بيانات قابلة للتصدير من الصفحة.");
        }

        await copyToClipboard(finalData);

        button.textContent = "✅";
        button.style.color = "#2f9e44";

        setTimeout(() => {
          button.textContent = "📥";
          button.style.color = "#087f5b";
          button.disabled = false;
        }, 2500);
      } catch (error) {
        console.error("CSV Export Error:", error);
        alert("حدث خطأ أثناء استخراج البيانات:\n\n" + error.message);

        button.textContent = "❌";
        button.style.color = "#c92a2a";
        setTimeout(() => {
          button.textContent = "📥";
          button.style.color = "#087f5b";
          button.disabled = false;
        }, 2500);
      }
    });

    container.appendChild(button);
    document.body.appendChild(container);
  }

  function init() {
    if (!document.body) {
      setTimeout(init, 500);
      return;
    }
    createButton();
  }

  init();
})();
